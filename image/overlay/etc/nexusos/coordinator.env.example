# Prefer: nexusos-provision --api-token … --join-token … --advertise https://host:8080 --start
# Or copy this file to /etc/nexusos/coordinator.env and fill in real secrets.
# Outside --dev, the coordinator refuses to start without API token, join-token, and TLS files.
# Placeholders CHANGE_ME* are rejected by coordinator-preflight.sh.

NEXUS_API_TOKEN=CHANGE_ME_API_TOKEN
NEXUS_JOIN_TOKEN=CHANGE_ME_JOIN_TOKEN
NEXUS_ADVERTISE=https://127.0.0.1:8080

# TLS files (nexusos-provision generates self-signed, or use your CA):
#   /etc/nexusos/tls.crt
#   /etc/nexusos/tls.key
# Permissions: root:root, key mode 0600.
