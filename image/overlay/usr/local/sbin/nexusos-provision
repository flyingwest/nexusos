#!/usr/bin/env bash
# Provision NexusOS node coordinator.env + TLS material (production first-boot helper).
# Does not invent secrets: tokens must be supplied via flags, env, or interactive prompt.
set -euo pipefail

ETC_DIR="${NEXUS_ETC_DIR:-/etc/nexusos}"
ENV_FILE="${ETC_DIR}/coordinator.env"
ENV_EXAMPLE="${ETC_DIR}/coordinator.env.example"
TLS_CRT="${ETC_DIR}/tls.crt"
TLS_KEY="${ETC_DIR}/tls.key"

API_TOKEN="${NEXUS_API_TOKEN:-}"
JOIN_TOKEN="${NEXUS_JOIN_TOKEN:-}"
ADVERTISE="${NEXUS_ADVERTISE:-}"
FORCE=0
GEN_TLS=1
ENABLE=0
START=0
TLS_DAYS="${NEXUS_TLS_DAYS:-825}"
NONINTERACTIVE=0

usage() {
  cat <<'USAGE'
Usage: nexusos-provision [options]

Create /etc/nexusos/coordinator.env and self-signed TLS for production nodes.
Refuses to overwrite an existing env file unless --force is set.
Does not invent API/join tokens — pass them explicitly.

Options:
  --api-token TOKEN       Operator API bearer token (or NEXUS_API_TOKEN)
  --join-token TOKEN      Peer join token (or NEXUS_JOIN_TOKEN)
  --advertise URL         Advertise URL (default: https://<hostname>:8080)
  --etc-dir DIR           Config directory (default: /etc/nexusos; for tests)
  --force                 Overwrite existing coordinator.env
  --no-tls                Do not generate TLS (leave existing or require operator)
  --tls-days N            Self-signed validity days (default: 825)
  --enable                systemctl enable nexusos-coordinator
  --start                 systemctl start nexusos-coordinator (implies --enable)
  --yes                   Non-interactive: fail if tokens missing (no prompts)
  -h, --help              Show this help

Examples:
  nexusos-provision --api-token "$API" --join-token "$JOIN" --advertise https://node1.example:8080 --start
  NEXUS_API_TOKEN=... NEXUS_JOIN_TOKEN=... nexusos-provision --yes --start
USAGE
}

is_placeholder() {
  local v="${1:-}"
  [[ -z "$v" ]] && return 0
  case "$v" in
    CHANGE_ME|CHANGE_ME_*|CHANGE_ME*) return 0 ;;
  esac
  return 1
}

hostname_fqdn() {
  if command -v hostname >/dev/null 2>&1; then
    hostname -f 2>/dev/null || hostname 2>/dev/null || echo "nexusos-node"
  else
    echo "nexusos-node"
  fi
}

parse_host_from_url() {
  # crude parse: scheme://host:port/... → host
  local u="$1"
  u="${u#*://}"
  u="${u%%/*}"
  u="${u%%:*}"
  printf '%s' "$u"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --api-token) API_TOKEN="$2"; shift 2 ;;
    --join-token) JOIN_TOKEN="$2"; shift 2 ;;
    --advertise) ADVERTISE="$2"; shift 2 ;;
    --etc-dir) ETC_DIR="$2"; ENV_FILE="${ETC_DIR}/coordinator.env"; ENV_EXAMPLE="${ETC_DIR}/coordinator.env.example"; TLS_CRT="${ETC_DIR}/tls.crt"; TLS_KEY="${ETC_DIR}/tls.key"; shift 2 ;;
    --force) FORCE=1; shift ;;
    --no-tls) GEN_TLS=0; shift ;;
    --tls-days) TLS_DAYS="$2"; shift 2 ;;
    --enable) ENABLE=1; shift ;;
    --start) START=1; ENABLE=1; shift ;;
    --yes|--non-interactive) NONINTERACTIVE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

install -d -m 0755 "$ETC_DIR"

if [[ -f "$ENV_FILE" && "$FORCE" -ne 1 ]]; then
  echo "refusing to overwrite $ENV_FILE (pass --force)" >&2
  exit 1
fi

if is_placeholder "$API_TOKEN"; then
  if [[ "$NONINTERACTIVE" -eq 1 ]]; then
    echo "NEXUS_API_TOKEN / --api-token required (non-empty, not CHANGE_ME*)" >&2
    exit 1
  fi
  if [[ -t 0 ]]; then
    read -r -p "API token: " API_TOKEN
  else
    echo "NEXUS_API_TOKEN / --api-token required" >&2
    exit 1
  fi
fi
if is_placeholder "$JOIN_TOKEN"; then
  if [[ "$NONINTERACTIVE" -eq 1 ]]; then
    echo "NEXUS_JOIN_TOKEN / --join-token required (non-empty, not CHANGE_ME*)" >&2
    exit 1
  fi
  if [[ -t 0 ]]; then
    read -r -s -p "Join token: " JOIN_TOKEN
    echo
  else
    echo "NEXUS_JOIN_TOKEN / --join-token required" >&2
    exit 1
  fi
fi
if is_placeholder "$API_TOKEN" || is_placeholder "$JOIN_TOKEN"; then
  echo "tokens must be non-empty and not CHANGE_ME* placeholders" >&2
  exit 1
fi

if [[ -z "$ADVERTISE" ]]; then
  hn="$(hostname_fqdn)"
  ADVERTISE="https://${hn}:8080"
fi

umask 077
cat > "$ENV_FILE" <<ENV
# Generated by nexusos-provision on $(date -u +%Y-%m-%dT%H:%M:%SZ)
NEXUS_API_TOKEN=${API_TOKEN}
NEXUS_JOIN_TOKEN=${JOIN_TOKEN}
NEXUS_ADVERTISE=${ADVERTISE}
ENV
chmod 0600 "$ENV_FILE"
chown root:root "$ENV_FILE" 2>/dev/null || true

if [[ "$GEN_TLS" -eq 1 ]]; then
  if [[ -f "$TLS_CRT" && -f "$TLS_KEY" && "$FORCE" -ne 1 ]]; then
    echo "TLS already present at $TLS_CRT / $TLS_KEY (leaving in place; --force regenerates)"
  else
    need_openssl() { command -v openssl >/dev/null 2>&1 || { echo "openssl required to generate TLS" >&2; exit 1; }; }
    need_openssl
    cn="$(parse_host_from_url "$ADVERTISE")"
    [[ -n "$cn" ]] || cn="nexusos-node"
    # Also include localhost / 127.0.0.1 for local operator probes.
    san="DNS:${cn},DNS:localhost,IP:127.0.0.1"
    # If advertise host looks like an IP, add IP SAN.
    if [[ "$cn" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      san="IP:${cn},DNS:localhost,IP:127.0.0.1"
    fi
    tmp="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap 'rm -rf "$tmp"' EXIT
    cat > "$tmp/openssl.cnf" <<OPENSSL
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no
[req_distinguished_name]
CN = ${cn}
[v3_req]
subjectAltName = ${san}
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
OPENSSL
    openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout "$tmp/tls.key" \
      -out "$tmp/tls.crt" \
      -days "$TLS_DAYS" \
      -config "$tmp/openssl.cnf" \
      -subj "/CN=${cn}" \
      2>/dev/null
    install -m 0644 "$tmp/tls.crt" "$TLS_CRT"
    install -m 0600 "$tmp/tls.key" "$TLS_KEY"
    chown root:root "$TLS_CRT" "$TLS_KEY" 2>/dev/null || true
    rm -rf "$tmp"
    trap - EXIT
    echo "wrote self-signed TLS: $TLS_CRT $TLS_KEY (CN/SAN for ${cn})"
  fi
fi

# Ensure key mode even if pre-existing
if [[ -f "$TLS_KEY" ]]; then
  chmod 0600 "$TLS_KEY"
fi
if [[ -f "$TLS_CRT" ]]; then
  chmod 0644 "$TLS_CRT"
fi

echo "wrote $ENV_FILE (mode 0600)"
echo "advertise=$ADVERTISE"

if [[ "$ENABLE" -eq 1 ]]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable nexusos-coordinator.service
    if [[ "$START" -eq 1 ]]; then
      systemctl start nexusos-coordinator.service
      echo "enabled + started nexusos-coordinator"
    else
      echo "enabled nexusos-coordinator (not started; pass --start)"
    fi
  else
    echo "systemctl not available; skip --enable/--start" >&2
  fi
else
  echo "Next: systemctl enable --now nexusos-coordinator"
  echo "  or: nexusos-provision ... --start"
fi
